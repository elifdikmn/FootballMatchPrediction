# Local default is sqlite:///matches.db. Use the Supabase pooler connection
# string in GitHub Actions and production.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres
FOOTBALL_DATA_TOKEN=replace-with-football-data-org-token
MODEL_VERSION=baseline-v1
API_FOOTBALL_KEY=optional-api-football-key
THE_ODDS_API_KEY=optional-odds-api-key
FLASK_DEBUG=false
SQL_ECHO=false
PORT=5001

# Optional override, for example 2026-27. By default it follows the current
# European football season.
OPENFOOTBALL_SEASON=
